# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# AI assistant in the Draw tab (server only). Leave AI_API_KEY empty to turn it off.
# AI_PROVIDER: gemini (default; free key at aistudio.google.com) | anthropic (console.anthropic.com) | openai
# openai covers any OpenAI-style API via AI_BASE_URL, e.g. Groq: https://api.groq.com/openai/v1
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: model override (defaults: gemini-3.8-flash, claude-sonnet-5-5, gpt-4o-mini) and base URL
AI_MODEL=
AI_BASE_URL=
# Optional fallback, used when the main model is busy, rate limited, out of credit or declines.
# e.g. Claude first, free Gemini second: AI_PROVIDER=anthropic + AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
# Comma-separated; defaults to the fallback provider's default model
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
