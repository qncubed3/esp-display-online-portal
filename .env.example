# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# AI assistant in the Draw tab (server only). Leave AI_API_KEY empty to turn it off.
# AI_PROVIDER: gemini (default, free tier at aistudio.google.com) | anthropic | openai
# openai covers any OpenAI-style API via AI_BASE_URL, e.g. Groq: https://api.groq.com/openai/v1
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides
AI_MODEL=
AI_BASE_URL=

# Web Push notifications (optional; without them notifications only show in the bell).
# Generate a key pair once with `npx web-push generate-vapid-keys` and paste both keys here.
# VAPID_SUBJECT is a contact address for push services: mailto:you@example.com (or an https:// URL).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
